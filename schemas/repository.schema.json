{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/jasonouellet/github-config/main/schemas/repository.schema.json",
  "title": "GitHub Repository Configuration",
  "description": "Schema v1.1.0 — validates repository configuration files in the config/ directory.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Repository name. Defaults to the YAML filename stem when omitted."
    },
    "description": {
      "type": "string",
      "description": "Short description of the repository."
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private", "internal"],
      "description": "Repository visibility: public, private, or internal."
    },
    "is_template": {
      "type": "boolean",
      "description": "Whether the repository is a template repository."
    },
    "auto_init": {
      "type": "boolean",
      "description": "Initialize the repository with a README on creation."
    },
    "gitignore_template": {
      "type": ["string", "null"],
      "description": "Gitignore template name, e.g. 'Terraform' or 'Python'."
    },
    "license_template": {
      "type": ["string", "null"],
      "description": "License template name, e.g. 'mit' or 'apache-2.0'."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "List of repository topics."
    },
    "archived": {
      "type": "boolean",
      "description": "Archive (make read-only) the repository."
    },
    "has_projects": {
      "type": "boolean",
      "description": "Enable the Projects tab for the repository."
    },
    "has_wiki": {
      "type": "boolean",
      "description": "Enable the Wiki tab for the repository."
    },
    "delete_branch_on_merge": {
      "type": "boolean",
      "description": "Automatically delete head branches when pull requests are merged."
    },
    "import_id": {
      "type": ["boolean", "null"],
      "description": "Set to true to import an existing repository into OpenTofu state before apply."
    },
    "rulesets": {
      "type": "array",
      "items": { "$ref": "#/definitions/ruleset" },
      "description": "Repository rulesets managed via github_repository_ruleset."
    }
  },
  "definitions": {

    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rules"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Ruleset name."
        },
        "target": {
          "type": "string",
          "enum": ["branch", "tag", "push"],
          "description": "Ruleset target."
        },
        "enforcement": {
          "type": "string",
          "enum": ["disabled", "active", "evaluate"],
          "description": "Ruleset enforcement mode."
        },
        "import_id": {
          "type": ["integer", "null"],
          "description": "Existing GitHub ruleset numeric ID to import."
        },
        "bypass_actors": {
          "type": "array",
          "items": { "$ref": "#/definitions/ruleset_bypass_actor" }
        },
        "conditions": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/ruleset_conditions" }
          ]
        },
        "rules": {
          "$ref": "#/definitions/ruleset_rules"
        }
      }
    },
    "ruleset_bypass_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "bypass_mode"],
      "properties": {
        "actor_id": {
          "type": ["integer", "null"]
        },
        "actor_type": {
          "type": "string"
        },
        "bypass_mode": {
          "type": "string",
          "enum": ["always", "pull_request", "exempt"]
        }
      }
    },
    "ruleset_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_name"],
      "properties": {
        "ref_name": {
          "$ref": "#/definitions/ruleset_ref_name"
        }
      }
    },
    "ruleset_ref_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ruleset_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creation": { "type": ["boolean", "null"] },
        "update": { "type": ["boolean", "null"] },
        "deletion": { "type": ["boolean", "null"] },
        "required_linear_history": { "type": ["boolean", "null"] },
        "required_signatures": { "type": ["boolean", "null"] },
        "non_fast_forward": { "type": ["boolean", "null"] },
        "update_allows_fetch_and_merge": { "type": ["boolean", "null"] },
        "pull_request": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/ruleset_rule_pull_request" }
          ]
        },
        "required_status_checks": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/ruleset_rule_required_status_checks" }
          ]
        },
        "required_code_scanning": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/ruleset_rule_required_code_scanning" }
          ]
        },
        "copilot_code_review": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/ruleset_rule_copilot_code_review" }
          ]
        }
      }
    },
    "ruleset_rule_pull_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dismiss_stale_reviews_on_push": { "type": "boolean" },
        "require_code_owner_review": { "type": "boolean" },
        "require_last_push_approval": { "type": "boolean" },
        "required_approving_review_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "required_review_thread_resolution": { "type": "boolean" },
        "allowed_merge_methods": {
          "type": "array",
          "items": { "type": "string", "enum": ["merge", "squash", "rebase"] },
          "minItems": 1
        },
        "required_reviewers": {
          "type": "array",
          "items": { "$ref": "#/definitions/ruleset_required_reviewer_group" }
        }
      }
    },
    "ruleset_required_reviewer_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_patterns", "minimum_approvals", "reviewer"],
      "properties": {
        "file_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "minimum_approvals": {
          "type": "integer",
          "minimum": 0
        },
        "reviewer": {
          "$ref": "#/definitions/ruleset_reviewer"
        }
      }
    },
    "ruleset_reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "integer" },
        "type": { "type": "string" }
      }
    },
    "ruleset_rule_required_status_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict_required_status_checks_policy": { "type": "boolean" },
        "do_not_enforce_on_create": { "type": "boolean" },
        "required_check": {
          "type": "array",
          "items": { "$ref": "#/definitions/ruleset_required_check" }
        }
      }
    },
    "ruleset_required_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context"],
      "properties": {
        "context": { "type": "string" },
        "integration_id": { "type": ["integer", "null"] }
      }
    },
    "ruleset_rule_required_code_scanning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_code_scanning_tool"],
      "properties": {
        "required_code_scanning_tool": {
          "type": "array",
          "items": { "$ref": "#/definitions/ruleset_code_scanning_tool" },
          "minItems": 1
        }
      }
    },
    "ruleset_code_scanning_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "alerts_threshold", "security_alerts_threshold"],
      "properties": {
        "tool": { "type": "string" },
        "alerts_threshold": {
          "type": "string",
          "enum": ["none", "errors", "errors_and_warnings", "all"]
        },
        "security_alerts_threshold": {
          "type": "string",
          "enum": ["none", "critical", "high_or_higher", "medium_or_higher", "all"]
        }
      }
    },
    "ruleset_rule_copilot_code_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_on_push": { "type": "boolean" },
        "review_draft_pull_requests": { "type": "boolean" }
      }
    }
  }
}
